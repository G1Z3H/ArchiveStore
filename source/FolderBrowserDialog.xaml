<tk:ConsoleWindow x:Class="ArchiveStore.FolderBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArchiveStore"
        xmlns:tk="clr-namespace:ArgentToolkit"
        Title="ArchiveStore — Choisir un dossier"
        Width="1080">

    <tk:ConsoleWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ConsoleStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </tk:ConsoleWindow.Resources>

    <!--
        Navigateur de dossiers pour la manette : disques → sous-dossiers → « Choisir ce dossier ».
        Une autre façon de choisir est intégrée : la boîte de dossier de Windows (bouton Y).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="40,32,40,24">
            <tk:ConsoleHeader Section="Dossier"/>

            <TextBlock x:Name="TitleText" Style="{StaticResource TitleStyle}" TextWrapping="Wrap"/>

            <!-- Où l'on se trouve -->
            <Border Style="{StaticResource CardStyle}" Padding="16,10" Margin="0,8,0,14">
                <TextBlock x:Name="PathText"
                           FontSize="16"
                           Foreground="{StaticResource AccentBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </Border>

            <ListBox x:Name="FolderList"
                     Height="400"
                     SelectionMode="Single"
                     MouseLeftButtonUp="FolderList_MouseLeftButtonUp">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" FontSize="17" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Detail}"
                                       Visibility="{Binding DetailVisibility}"
                                       FontSize="13.5"
                                       Opacity="0.75"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="HelpText" Style="{StaticResource NoteStyle}" FontSize="14" Margin="0,14,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource FooterStyle}">
            <DockPanel LastChildFill="True">
                <Button x:Name="BtnCancel"
                        DockPanel.Dock="Right"
                        Content="Annuler"
                        MinWidth="140"
                        Margin="14,0,0,0"
                        Click="BtnCancel_Click"/>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <tk:PadHint Pad="D" Label="Naviguer"/>
                    <tk:PadHint Pad="A" Label="Ouvrir / Choisir"/>
                    <tk:PadHint Pad="H" Label="Parent / Ouvrir"/>
                    <tk:PadHint Pad="Y" Label="Boîte Windows" Cursor="Hand" MouseLeftButtonUp="HintY_Click"/>
                    <tk:PadHint Pad="B" Label="Annuler"/>
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</tk:ConsoleWindow>
