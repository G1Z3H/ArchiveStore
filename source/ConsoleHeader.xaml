<UserControl x:Class="ArchiveStore.ConsoleHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        L'en-tête commun : le logo, « ARCHIVESTORE · SECTION » et, dessous, le nom du jeu.
        Utilisation :  <local:ConsoleHeader x:Name="Header" Section="Installation"/>
        puis, dans le code :  Header.Game = "Cyberpunk 2077";
        Le logo (LogoImage) vient de ConsoleStyle.xaml : DynamicResource = cherché au moment de
        l'affichage, quand ce contrôle est déjà dans la fenêtre.
    -->
    <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
        <Image Source="{DynamicResource LogoImage}" Width="44" Height="44" VerticalAlignment="Center"/>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="SectionText"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#7f849c"/>
            <TextBlock x:Name="GameText"
                       FontSize="15"
                       Foreground="#a6adc8"
                       Margin="0,2,0,0"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed"/>
        </StackPanel>
    </StackPanel>
</UserControl>
