<Window x:Class="ArchiveStore.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ArchiveStore"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <!-- Même style « console » que nos autres fenêtres (voir ConsoleStyle.xaml). -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ConsoleStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!--
        Petite carte en bas à droite, purement informative : aucun clic, aucun focus.
        (Technique déjà validée dans le plugin Steam Silent : ShowActivated="False" + Topmost="True" +
        Focusable="False" + IsHitTestVisible="False".)
    -->
    <Grid Margin="20" IsHitTestVisible="False">
        <Border Background="{StaticResource BgBrush}" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.55"/>
            </Border.Effect>
        </Border>
        <Border Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource Line2Brush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18,16">
            <StackPanel Orientation="Horizontal">
                <Image Source="{StaticResource LogoImage}" Width="40" Height="40" VerticalAlignment="Top"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" MaxWidth="380">
                    <TextBlock x:Name="TitleText"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="MessageText"
                               FontSize="14"
                               Foreground="{StaticResource DimBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                    <!-- Indication facultative (ex. « ouvrez les notifications de Playnite pour agir »). -->
                    <TextBlock x:Name="HintText"
                               FontSize="12.5"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
