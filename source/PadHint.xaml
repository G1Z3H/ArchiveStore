<UserControl x:Class="ArchiveStore.PadHint"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Une « astuce de touche » du pied de fenêtre : une pastille ronde colorée (A, B, X, Y)
        ou une plaque (croix directionnelle), suivie de ce que fait la touche.
        Utilisation :  <local:PadHint Pad="A" Label="Valider"/>
        Background="Transparent" : sans lui, WPF ne détecte pas le clic sur les zones vides
        (utile quand l'astuce sert aussi de bouton à la souris, comme X et Y dans « DLC et patchs »).
    -->
    <StackPanel Orientation="Horizontal"
                Background="Transparent"
                VerticalAlignment="Center"
                Margin="0,0,24,0">
        <Border x:Name="Badge"
                Width="28" Height="28"
                CornerRadius="14"
                VerticalAlignment="Center">
            <TextBlock x:Name="PadText"
                       FontSize="14"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="LabelText"
                   FontSize="15"
                   Foreground="#a6adc8"
                   VerticalAlignment="Center"
                   Margin="9,0,0,0"/>
    </StackPanel>
</UserControl>
