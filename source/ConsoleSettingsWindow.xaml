<tk:ConsoleWindow x:Class="ArchiveStore.ConsoleSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArchiveStore"
        xmlns:tk="clr-namespace:ArgentToolkit"
        Title="ArchiveStore — Réglages"
        Width="1228">

    <tk:ConsoleWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ConsoleStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </tk:ConsoleWindow.Resources>

    <!--
        Réglages d'ArchiveStore pour la manette (mode Plein écran) — mêmes réglages que l'écran classique du
        mode Bureau. Deux colonnes : les catégories à gauche, les réglages de la catégorie à droite.
        Le contenu de la colonne de droite est construit en code (ConsoleSettingsWindow.xaml.cs).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Colonne de gauche : les catégories -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,1,0"
                    CornerRadius="19,0,0,0"
                    Padding="22,30,22,16">
                <DockPanel>
                    <tk:ConsoleHeader DockPanel.Dock="Top" Section="Réglages"/>
                    <ScrollViewer Focusable="False"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="NavPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Colonne de droite : les réglages de la catégorie choisie -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="CategoryTitle"
                           Grid.Row="0"
                           Style="{StaticResource TitleStyle}"
                           Margin="40,34,40,0"
                           TextTrimming="CharacterEllipsis"/>

                <ScrollViewer x:Name="ContentScroll"
                              Grid.Row="1"
                              Focusable="False"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ContentHost" Margin="40,0,40,24"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource FooterStyle}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnCancel"
                            Content="Annuler"
                            MinWidth="140"
                            Margin="0,0,14,0"
                            Click="BtnCancel_Click"/>
                    <Button x:Name="BtnSave"
                            Content="Enregistrer"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="160"
                            Click="BtnSave_Click"/>
                </StackPanel>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <tk:PadHint Pad="D" Label="Naviguer"/>
                    <tk:PadHint Pad="H" Label="Catégories"/>
                    <tk:PadHint Pad="A" Label="Choisir"/>
                    <tk:PadHint Pad="Y" Label="Enregistrer"/>
                    <tk:PadHint Pad="B" Label="Annuler"/>
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</tk:ConsoleWindow>
