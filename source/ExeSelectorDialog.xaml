<local:ConsoleWindow x:Class="ArchiveStore.ExeSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArchiveStore"
        Title="ArchiveStore — Choisir l'exécutable"
        Width="980">

    <local:ConsoleWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ConsoleStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:ConsoleWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="40,32,40,24">
            <local:ConsoleHeader x:Name="Header" Section="Exécutable principal"/>

            <TextBlock Text="Sélectionnez l'exécutable principal du jeu" Style="{StaticResource TitleStyle}"/>
            <TextBlock Text="Le plus gros fichier est recommandé : c'est presque toujours le jeu."
                       Style="{StaticResource DescStyle}"
                       Margin="0,10,0,16"/>

            <ListBox x:Name="ExeList"
                     MaxHeight="380"
                     MouseDoubleClick="ExeList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="290"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"
                                           MaxWidth="190"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <Border Background="#a6e3a1"
                                        CornerRadius="6"
                                        Padding="8,2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="RECOMMANDÉ" FontSize="12" FontWeight="Bold" Foreground="#11111b"/>
                                </Border>
                            </StackPanel>

                            <!-- Opacity plutôt qu'une couleur fixe : le texte reste lisible quand la ligne est bleue. -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SizeDisplay}"
                                       FontSize="15"
                                       Opacity="0.75"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Path}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="12.5"
                                       Opacity="0.6"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource FooterStyle}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnCancel"
                            Content="Annuler"
                            MinWidth="140"
                            Margin="0,0,14,0"
                            Click="BtnCancel_Click"/>
                    <Button x:Name="BtnConfirm"
                            Content="Sélectionner"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="190"
                            Click="BtnConfirm_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <local:PadHint Pad="D" Label="Naviguer"/>
                    <local:PadHint Pad="A" Label="Sélectionner"/>
                    <local:PadHint Pad="B" Label="Annuler"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</local:ConsoleWindow>
