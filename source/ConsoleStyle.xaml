<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ======================================================================
        ConsoleStyle.xaml — le style « console » commun à TOUTES les fenêtres
        d'ArchiveStore (installation, exécutable, DLC et patchs, destination,
        progression, confirmation).

        PÉDAGOGIE : un ResourceDictionary est un « tiroir de styles ». Chaque
        fenêtre le charge une fois (voir le début de chaque .xaml) et peut alors
        écrire Style="{StaticResource TitleStyle}". Changer une couleur ICI la
        change dans toutes les fenêtres d'un coup.

        Palette : celle de Catppuccin « Mocha » (déjà utilisée avant).
        ======================================================================
    -->

    <!-- ============================ COULEURS ============================ -->
    <SolidColorBrush x:Key="BgBrush" Color="#1e1e2e"/>
    <SolidColorBrush x:Key="CardBrush" Color="#181825"/>
    <SolidColorBrush x:Key="LineBrush" Color="#313244"/>
    <SolidColorBrush x:Key="Line2Brush" Color="#45475a"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#585b70"/>
    <SolidColorBrush x:Key="TextBrush" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="DimBrush" Color="#a6adc8"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#7f849c"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#89b4fa"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#1e66f5"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#a6e3a1"/>
    <SolidColorBrush x:Key="GreenBgBrush" Color="#1c2a24"/>
    <SolidColorBrush x:Key="RedBrush" Color="#f38ba8"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="#fab387"/>
    <SolidColorBrush x:Key="FocusBgBrush" Color="#262a40"/>
    <SolidColorBrush x:Key="DarkBrush" Color="#11111b"/>

    <!-- Halo bleu autour de l'élément qui a le focus (c'est LUI qui montre où on est à la manette). -->
    <DropShadowEffect x:Key="GlowEffect" Color="#89b4fa" BlurRadius="16" ShadowDepth="0" Opacity="0.55"/>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- ============================ LOGO ============================ -->
    <!-- Dessiné en vectoriel (aucune image à copier) : une boîte d'archives avec un triangle « jouer ». -->
    <DrawingImage x:Key="LogoImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#232c47">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="8,8,240,240" RadiusX="52" RadiusY="52"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#8fa0ff">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="52,60,152,40" RadiusX="10" RadiusY="10"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#2f3a5c">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="64,100,128,100" RadiusX="12" RadiusY="12"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#111624">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="102,113,52,11" RadiusX="5.5" RadiusY="5.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4af0d0" Offset="0"/>
                            <GradientStop Color="#4aa8ff" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen>
                        <Pen Thickness="6" LineJoin="Round" Brush="#4ac8ea"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M112,140 L112,184 L152,162 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ============================ FENÊTRE ============================ -->
    <!--
        Le cadre de la fenêtre : coins arrondis + ombre portée, SANS la barre blanche
        de Windows ni la croix. La fenêtre est transparente (AllowsTransparency, réglé
        dans ConsoleWindow.cs) et ce modèle dessine le cadre par-dessus.
        L'ombre est sur un rectangle SÉPARÉ, derrière : ainsi le contenu n'est pas
        redessiné à travers l'effet à chaque mise à jour (barre de progression fluide).
        La marge de 24 laisse la place à l'ombre : Width d'une fenêtre = largeur voulue + 48.
    -->
    <Style x:Key="ConsoleWindowStyle" TargetType="Window">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Grid Margin="24">
                        <Border Background="{StaticResource BgBrush}" CornerRadius="20">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.6"/>
                            </Border.Effect>
                        </Border>
                        <Border Background="{StaticResource BgBrush}"
                                BorderBrush="{StaticResource Line2Brush}"
                                BorderThickness="1"
                                CornerRadius="20">
                            <AdornerDecorator>
                                <ContentPresenter/>
                            </AdornerDecorator>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ TEXTES ============================ -->
    <Style x:Key="TitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style x:Key="FileStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <Style x:Key="DescStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16.5"/>
        <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,14,0,20"/>
    </Style>

    <Style x:Key="LabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="ValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style x:Key="NoteStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>

    <Style x:Key="WarnRedStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,14,0,0"/>
    </Style>

    <Style x:Key="WarnOrangeStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource OrangeBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- Petite phrase sous une option (rappel du dossier à choisir, mise en garde). -->
    <Style x:Key="OptionHintStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="18,0,0,14"/>
    </Style>

    <Style x:Key="OptionWarnStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource OrangeBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="18,0,0,6"/>
    </Style>

    <!-- Titre de groupe dans une liste (« DLC », « PATCHS »…). -->
    <Style x:Key="GroupStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
        <Setter Property="Margin" Value="0,14,0,6"/>
    </Style>

    <!-- ============================ CARTE ET PIED DE FENÊTRE ============================ -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="20,18"/>
    </Style>

    <Style x:Key="FooterStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="CornerRadius" Value="0,0,19,19"/>
        <Setter Property="Padding" Value="40,16"/>
    </Style>

    <!-- ============================ BOUTONS ============================ -->
    <Style TargetType="Button">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"/>
                        <!-- Voile blanc léger au survol de la souris (marche pour tous les boutons, bleu compris). -->
                        <Border x:Name="Hover" Background="White" CornerRadius="10" Opacity="0" IsHitTestVisible="False"/>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.1"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource GlowEffect}"/>
                        </Trigger>
                        <!-- Bouton grisé (ex. « Installer » quand l'espace disque est insuffisant) -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Bouton « liste déroulante » (choix de la destination) : texte à gauche, chevron à droite. -->
    <Style x:Key="SelectorButton" TargetType="Button">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{StaticResource LineBrush}"
                            BorderBrush="{StaticResource Line2Brush}"
                            BorderThickness="2"
                            CornerRadius="10"
                            Padding="16,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="▼"
                                       FontSize="13"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource GlowEffect}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ OPTIONS (boutons radio) ============================ -->
    <Style TargetType="RadioButton">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="2"
                            CornerRadius="12"
                            Padding="18,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="22" Height="22" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Stroke="{StaticResource MutedBrush}" StrokeThickness="2"/>
                                <Ellipse x:Name="Dot" Margin="5" Fill="{StaticResource GreenBrush}" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Line2Brush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource GlowEffect}"/>
                        </Trigger>
                        <!-- Option choisie : vert (placé APRÈS le focus, donc il garde sa bordure verte même avec le halo). -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GreenBgBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GreenBrush}"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource GreenBrush}"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ CASES À COCHER ============================ -->
    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Margin" Value="0,2,0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="10"
                            Padding="12,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="24" Height="24"
                                    CornerRadius="7"
                                    BorderThickness="2"
                                    BorderBrush="{StaticResource MutedBrush}"
                                    Background="Transparent"
                                    VerticalAlignment="Center">
                                <!-- Coche dessinée (pas de caractère spécial : toujours bien rendue). -->
                                <Path x:Name="Tick"
                                      Data="M0,5 L4,9 L12,0"
                                      Stroke="{StaticResource DarkBrush}"
                                      StrokeThickness="2.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="None"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FocusBgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FocusBgBrush}"/>
                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource GlowEffect}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource GreenBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GreenBrush}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ LISTES ============================ -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="FontSize" Value="16.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FocusBgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <!-- Sélectionné ET la liste a le focus : halo bleu. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="Selector.IsSelectionActive" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource GlowEffect}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ BARRE DE PROGRESSION ============================ -->
    <!--
        Barre à pilules. Deux modes :
        - déterminée : PART_Indicator est dimensionné automatiquement par WPF (Value/Maximum) ;
        - indéterminée : on cache l'indicateur et on fait glisser une zone lumineuse (Marquee).
        PART_Track et PART_Indicator sont des NOMS OBLIGATOIRES : WPF les cherche dans le modèle.
    -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="16"/>
        <Setter Property="Background" Value="{StaticResource LineBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="TemplateRoot" ClipToBounds="True">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"/>
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="8"
                                HorizontalAlignment="Left"/>
                        <Border x:Name="Marquee"
                                Width="170"
                                CornerRadius="8"
                                HorizontalAlignment="Left"
                                Margin="-170,0,0,0"
                                Visibility="Collapsed">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#0089b4fa" Offset="0"/>
                                    <GradientStop Color="#89b4fa" Offset="0.5"/>
                                    <GradientStop Color="#0089b4fa" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Marquee" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MarqueeStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <ThicknessAnimation Storyboard.TargetName="Marquee"
                                                            Storyboard.TargetProperty="Margin"
                                                            From="-170,0,0,0"
                                                            To="720,0,0,0"
                                                            Duration="0:0:1.8"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="MarqueeStoryboard"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ============ LIGNES DE RÉGLAGE ET CATÉGORIES (fenêtre de réglages console) ============ -->
    <!--
        RowButton : une ligne de réglage cliquable (valeur à changer, action, élément d'une liste). Comme les autres
        éléments « console », c'est le halo bleu (IsKeyboardFocused) qui montre où l'on est à la manette.
        Pas de BasedOn : cette ligne n'hérite donc ni de la hauteur fixe ni de la largeur minimale des gros boutons.
    -->
    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="FontSize" Value="16.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{StaticResource LineBrush}"
                            BorderBrush="{StaticResource Line2Brush}"
                            BorderThickness="2"
                            CornerRadius="12"
                            Padding="16,12">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FocusBgBrush}"/>
                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource GlowEffect}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        NavButton : une catégorie de la colonne de gauche. La catégorie AFFICHÉE à droite est repérée par
        Tag="sel" (posé par le code de la fenêtre) : fond plus clair et petite flèche. Le halo bleu, lui,
        montre où est le focus (la manette) : les deux peuvent être sur la même ligne ou non.
    -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="12"
                            Padding="18,13">
                        <DockPanel>
                            <TextBlock x:Name="Chev"
                                       DockPanel.Dock="Right"
                                       Text="›"
                                       FontSize="20"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="Hidden"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource LineBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="sel">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FocusBgBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Line2Brush}"/>
                            <Setter TargetName="Chev" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FocusBgBrush}"/>
                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource GlowEffect}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
