<local:ConsoleWindow x:Class="ArchiveStore.ExistingFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArchiveStore"
        Title="ArchiveStore — Dossier existant"
        Width="900">

    <!-- Le style « console » commun (voir ConsoleStyle.xaml). -->
    <local:ConsoleWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ConsoleStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:ConsoleWindow.Resources>

    <!--
        Fenêtre affichée quand le dossier de destination du jeu EXISTE DÉJÀ et contient des fichiers
        (installation ratée, jeu venu d'ailleurs, copie à la main…). Le plugin n'écrase jamais rien sans
        que l'utilisateur l'ait choisi, et il ne vide jamais un dossier : il n'y a donc PAS de bouton
        « Supprimer et réinstaller ».
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0 : contenu -->
            <RowDefinition Height="Auto"/>   <!-- 1 : pied de fenêtre (touches + boutons) -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="40,32,40,24">
            <local:ConsoleHeader x:Name="Header" Section="Dossier existant"/>

            <TextBlock Text="Ce dossier existe déjà :" Style="{StaticResource TitleStyle}"/>
            <TextBlock x:Name="PathText" Style="{StaticResource FileStyle}"/>

            <!-- Ce que fait chacun des trois boutons. -->
            <TextBlock x:Name="ChoicesText" Style="{StaticResource DescStyle}"/>

            <!-- Avertissements (selon la méthode choisie : installeur reconnu ou non, jeu portable). -->
            <Border x:Name="WarnCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="WarnLine1" Style="{StaticResource WarnOrangeStyle}" Margin="0,0,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="WarnLine2" Style="{StaticResource WarnOrangeStyle}" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="WarnLine3" Style="{StaticResource WarnOrangeStyle}" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Bouton « tel quel » grisé : on dit pourquoi. -->
            <TextBlock x:Name="NoExeText" Style="{StaticResource WarnRedStyle}" Visibility="Collapsed"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource FooterStyle}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- « Annuler » en premier : c'est lui qui a le focus à l'ouverture (rien ne se détruit par erreur). -->
                    <Button x:Name="BtnCancel"
                            Content="Annuler"
                            MinWidth="140"
                            Margin="0,0,14,0"
                            Click="BtnCancel_Click"/>
                    <Button x:Name="BtnOverwrite"
                            Content="Écraser"
                            MinWidth="150"
                            Margin="0,0,14,0"
                            Click="BtnOverwrite_Click"/>
                    <Button x:Name="BtnAsIs"
                            Content="Utiliser ce dossier tel quel"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="260"
                            Click="BtnAsIs_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <local:PadHint Pad="H" Label="Choisir"/>
                    <local:PadHint Pad="A" Label="Valider"/>
                    <local:PadHint Pad="B" Label="Annuler"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</local:ConsoleWindow>
