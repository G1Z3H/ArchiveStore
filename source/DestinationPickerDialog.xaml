<local:ConsoleWindow x:Class="ArchiveStore.DestinationPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArchiveStore"
        Title="ArchiveStore — Destination d'installation"
        Width="860">

    <local:ConsoleWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ConsoleStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:ConsoleWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="40,32,40,24">
            <local:ConsoleHeader Section="Destination"/>

            <TextBlock x:Name="TitleText" Style="{StaticResource TitleStyle}"/>

            <!-- Jeux concernés -->
            <TextBlock x:Name="GamesText" Style="{StaticResource DescStyle}" Margin="0,10,0,16"/>

            <ListBox x:Name="DestinationList"
                     MaxHeight="260"
                     SelectionMode="Single"
                     DisplayMemberPath="Label"
                     SelectionChanged="DestinationList_SelectionChanged"
                     MouseDoubleClick="DestinationList_MouseDoubleClick"/>

            <TextBlock x:Name="HelpText" Style="{StaticResource NoteStyle}" FontSize="14" Margin="0,14,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource FooterStyle}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnCancel"
                            Content="Annuler"
                            MinWidth="140"
                            Margin="0,0,14,0"
                            Click="BtnCancel_Click"/>
                    <Button x:Name="BtnConfirm"
                            Content="Valider"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="160"
                            IsEnabled="False"
                            Click="BtnConfirm_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <local:PadHint Pad="D" Label="Naviguer"/>
                    <local:PadHint Pad="A" Label="Valider"/>
                    <local:PadHint Pad="B" Label="Annuler"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</local:ConsoleWindow>
