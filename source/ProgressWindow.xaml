<tk:ConsoleWindow x:Class="ArchiveStore.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArchiveStore"
        xmlns:tk="clr-namespace:ArgentToolkit"
        Title="ArchiveStore — Installation en cours"
        Width="810">

    <tk:ConsoleWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ConsoleStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </tk:ConsoleWindow.Resources>

    <!--
        Fenêtre de progression pour la COPIE des jeux portables (ÉTAPE C),
        réutilisée pour l'analyse et pour l'exécution d'un installeur
        (barre "en mouvement", sans bouton Annuler).
        Objectif : éviter l'effet "freeze" sur les gros jeux (dizaines de Go).

        PÉDAGOGIE — ProgressBar et threading :
        - IsIndeterminate="True"  → barre "en mouvement" sans %, utilisé quand
          on ne connaît pas la taille totale (ou qu'il n'y en a pas : installeur).
        - IsIndeterminate="False" → barre avec %, pilotée par Value/Maximum.
        - Le code-behind bascule de l'un à l'autre selon la taille totale reçue.
        - CRUCIAL : cette fenêtre est mise à jour depuis un thread d'arrière-plan
          (la copie tourne dans Task.Run). On ne peut PAS toucher une fenêtre
          WPF depuis un autre thread → le plugin passe par le Dispatcher
          pour rapatrier chaque mise à jour sur le thread UI. C'est la règle
          d'or des threads WPF (sinon : crash aléatoire).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="40,32,40,28">
            <tk:ConsoleHeader Section="Installation"/>

            <!-- Titre de la phase -->
            <TextBlock x:Name="TitleText" Text="Copie en cours…" Style="{StaticResource TitleStyle}"/>

            <!-- Nom du fichier en cours de copie -->
            <TextBlock x:Name="FileText"
                       Text="Préparation…"
                       Style="{StaticResource FileStyle}"
                       FontSize="15"
                       Foreground="{StaticResource DimBrush}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"/>

            <!-- Barre de progression. Passe en déterminée dès qu'on connaît le total. -->
            <ProgressBar x:Name="Progress" Height="16" IsIndeterminate="True" Margin="0,22,0,10"/>

            <!-- Taille copiée / totale à gauche, gros pourcentage à droite -->
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="PercentText"
                           DockPanel.Dock="Right"
                           FontSize="44"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"/>
                <TextBlock x:Name="SizeText"
                           FontSize="17"
                           Foreground="{StaticResource AccentBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock x:Name="NoteText"
                       Text="Annuler supprime les fichiers déjà copiés."
                       Style="{StaticResource NoteStyle}"
                       FontSize="14"
                       Margin="0,8,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- Pied de fenêtre : seulement si l'annulation est possible (copie) -->
        <Border x:Name="FooterPanel"
                Grid.Row="1"
                Style="{StaticResource FooterStyle}"
                Visibility="Collapsed">
            <DockPanel LastChildFill="True">
                <Button x:Name="BtnCancel"
                        DockPanel.Dock="Right"
                        Content="Annuler"
                        MinWidth="160"
                        Click="BtnCancel_Click"/>
                <Button x:Name="BtnBackground"
                        DockPanel.Dock="Right"
                        Content="En arrière-plan"
                        MinWidth="160"
                        Margin="0,0,16,0"
                        Visibility="Collapsed"
                        Click="BtnBackground_Click"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <tk:PadHint x:Name="HintBackground" Pad="Y" Label="Arrière-plan" Margin="0,0,24,0" Visibility="Collapsed"/>
                    <tk:PadHint x:Name="HintCancel" Pad="B" Label="Annuler"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</tk:ConsoleWindow>
