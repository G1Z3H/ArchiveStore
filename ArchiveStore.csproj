<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net462</TargetFramework>
		<NoWarn>IDE0130;IDE0270</NoWarn>
		<AssemblyName>ArchiveStore</AssemblyName>
		<RootNamespace>ArchiveStore</RootNamespace>
		<UseWPF>true</UseWPF>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="PlayniteSDK" Version="6.18.0" />
	</ItemGroup>

	<!-- Boîte à outils « console » partagée (dossier ..\ArgentToolkit) : fichiers dans source\, avec les fenêtres. -->
	<PropertyGroup>
		<ArgentToolkitLinkFolder>source\</ArgentToolkitLinkFolder>
	</PropertyGroup>
	<Import Project="..\ArgentToolkit\ArgentToolkit.props" />

	<ItemGroup>
		<None Include="extension.yaml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="icon.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="Localization\*.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>